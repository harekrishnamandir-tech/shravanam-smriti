# Copy to .env.local for development. Both values are public by design -
# row-level security in the database protects the data.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional: show the email magic-link sign-in in production builds (always on in dev)
# VITE_ENABLE_EMAIL_LOGIN=true
# Optional: GitHub Pages sub-path (defaults to /shravanam-smriti/)
# VITE_BASE_PATH=/shravanam-smriti/
